# ResumeIQ backend configuration — copy to backend/.env and edit.

# SQLite by default (zero setup). For Postgres use e.g.:
# DATABASE_URL=postgresql+psycopg2://resumeiq:resumeiq@localhost:5432/resumeiq
DATABASE_URL=

# Auth — CHANGE THIS in any shared/production environment.
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OAuth sign-in (leave empty to show a "not configured" hint on the buttons).
# Redirect URI to register in each provider console:
#   http://localhost:8000/api/auth/oauth/google/callback
#   http://localhost:8000/api/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional LLM enhancement. Leave LLM_API_KEY empty to run fully offline.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
